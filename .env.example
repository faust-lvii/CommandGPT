# LLM API Settings
# Base URL for your local LLM server (Ollama, LM Studio, etc.)
LLM_BASE_URL=http://localhost:1234/v1

# Model name (depends on your local LLM setup)
# Examples:
# - Ollama: "llama2", "mistral", "codellama" etc.
# - LM Studio: "local-model" or specific model name
LLM_MODEL_NAME=local-model

# OpenAI API key (optional for most local LLMs, required for OpenAI)
# OPENAI_API_KEY=your_api_key_here

# Generation parameters
# Temperature controls randomness (0.0-1.0)
# Lower values (0.1-0.3) for more deterministic/precise responses
# Higher values (0.7-1.0) for more creative/varied responses
LLM_TEMPERATURE=0.2

# Maximum tokens in the response
LLM_MAX_TOKENS=500